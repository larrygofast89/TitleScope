{
  "manifest_version": 3,
  "name": "TitleScope - intitle 结果数批量查询",
  "version": "1.2.0",
  "description": "批量查询关键词的 intitle / allintitle 搜索结果数,用于 SEO 关键词竞争度分析,支持导出 CSV。",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["https://www.google.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TitleScope",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
